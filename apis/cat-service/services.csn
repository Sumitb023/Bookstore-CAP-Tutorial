{
  "definitions": {
    "CatalogService": {
      "@source": "srv/cat-service.cds",
      "kind": "service",
      "@cds.external": 2
    },
    "CatalogService.Books": {
      "kind": "entity",
      "elements": {
        "createdAt": {
          "@Core.Immutable": true,
          "@title": "{i18n>CreatedAt}",
          "@readonly": true,
          "type": "cds.Timestamp"
        },
        "createdBy": {
          "@Core.Immutable": true,
          "@title": "{i18n>CreatedBy}",
          "@readonly": true,
          "@description": "{i18n>UserID.Description}",
          "type": "User",
          "length": 255
        },
        "modifiedAt": {
          "@title": "{i18n>ChangedAt}",
          "@readonly": true,
          "type": "cds.Timestamp"
        },
        "modifiedBy": {
          "@title": "{i18n>ChangedBy}",
          "@readonly": true,
          "@description": "{i18n>UserID.Description}",
          "type": "User",
          "length": 255
        },
        "ID": {
          "key": true,
          "type": "cds.UUID"
        },
        "title": {
          "type": "cds.String",
          "length": 100
        },
        "author": {
          "type": "cds.Association",
          "target": "CatalogService.Authors"
        },
        "stock": {
          "type": "cds.Integer"
        }
      }
    },
    "CatalogService.Authors": {
      "kind": "entity",
      "elements": {
        "createdAt": {
          "@Core.Immutable": true,
          "@title": "{i18n>CreatedAt}",
          "@readonly": true,
          "type": "cds.Timestamp"
        },
        "createdBy": {
          "@Core.Immutable": true,
          "@title": "{i18n>CreatedBy}",
          "@readonly": true,
          "@description": "{i18n>UserID.Description}",
          "type": "User",
          "length": 255
        },
        "modifiedAt": {
          "@title": "{i18n>ChangedAt}",
          "@readonly": true,
          "type": "cds.Timestamp"
        },
        "modifiedBy": {
          "@title": "{i18n>ChangedBy}",
          "@readonly": true,
          "@description": "{i18n>UserID.Description}",
          "type": "User",
          "length": 255
        },
        "ID": {
          "key": true,
          "type": "cds.UUID"
        },
        "name": {
          "type": "cds.String",
          "length": 80
        },
        "books": {
          "type": "cds.Association",
          "cardinality": {
            "max": "*"
          },
          "target": "CatalogService.Books",
          "on": [
            {
              "ref": [
                "books",
                "author"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        }
      }
    },
    "CatalogService.submitOrder": {
      "kind": "action",
      "params": {
        "book": {
          "type": "cds.UUID"
        },
        "quantity": {
          "type": "cds.Integer"
        }
      },
      "returns": {
        "type": "cds.String"
      }
    }
  },
  "meta": {
    "creator": "CDS Compiler v6.9.0",
    "compilerVersion": "6.9.0",
    "compilerCsnFlavor": "inferred",
    "flavor": "inferred",
    "minified": true
  },
  "$version": "2.0",
  "requires": [
    "@sap/cds/common"
  ]
}